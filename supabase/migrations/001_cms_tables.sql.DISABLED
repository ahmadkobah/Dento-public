COMMENT ON TABLE services IS 'Website services displayed on the services page';
COMMENT ON TABLE testimonials IS 'Patient testimonials and reviews';
COMMENT ON TABLE portfolio IS 'Before/after treatment photos';
COMMENT ON TABLE translations IS 'Dynamic translations for website content';
COMMENT ON TABLE users IS 'Staff users with roles for admin panel access';
